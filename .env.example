# Supabase público (cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase privado (solo servidor; nunca usar NEXT_PUBLIC_)
# Preferido en proyectos nuevos:
SUPABASE_SECRET_KEY=
# Compatibilidad con la clave service_role legacy:
SUPABASE_SERVICE_ROLE_KEY=

# SerpApi Google Maps Directions (solo servidor)
SERPAPI_API_KEY=

# Firma de cotizaciones de delivery (solo servidor)
# Generá un valor aleatorio largo, por ejemplo: openssl rand -hex 32
DELIVERY_QUOTE_SECRET=

# Cobros y pagos combinados
# Muestra el botón «Cobro» en Admin → Pedidos y habilita pago combinado en la UI.
NEXT_PUBLIC_ENABLE_MIXED_PAYMENTS=true
# Habilita el endpoint del servidor para crear pedidos con pago combinado.
# Requiere las migraciones/RPC de pagos instaladas en Supabase.
ENABLE_MIXED_PAYMENTS=true
