  "id": "/admin-app-v1",
  "start_url": "/admin/dashboard",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#F5F5F5",
  "theme_color": "#F5F5F5",
  "lang": "es-AR",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/api/pwa/icon/192",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/api/pwa/icon/512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pedidos",
      "short_name": "Pedidos",
      "url": "/admin/pedidos"
    },
    {
      "name": "Productos",
      "short_name": "Productos",
      "url": "/admin/productos"
    },
    {
      "name": "Reportes",
      "short_name": "Reportes",
      "url": "/admin/reportes"
    }
  ]
}
